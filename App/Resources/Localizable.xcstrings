    "Test logins": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldungen testen"
          }
        }
      }
    },
    "The .pub file does not match its private key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die .pub-Datei passt nicht zu ihrem privaten Schlüssel."
          }
        }
      }
    },
    "The Keychain returned an unexpected value.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüsselbund hat einen unerwarteten Wert zurückgegeben."
          }
        }
      }
    },
    "The OpenSSH built into macOS needs a FIDO provider library for security keys. Install one (for example via Homebrew) and enter its path under Security key options, then plug in the key and touch it when it blinks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das in macOS eingebaute OpenSSH braucht für Sicherheitsschlüssel eine FIDO-Provider-Bibliothek. Installiere eine (zum Beispiel über Homebrew) und gib ihren Pfad unter den Optionen für Sicherheitsschlüssel ein. Schließe dann den Schlüssel an und berühre ihn, wenn er blinkt."
          }
        }
      }
    },
    "The OpenSSH format protects passphrases with a stronger key derivation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das OpenSSH-Format schützt Passphrasen mit einer stärkeren Schlüsselableitung."
          }
        }
      }
    },
    "The Secure Enclave could not create a key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Secure Enclave konnte keinen Schlüssel erstellen."
          }
        }
      }
    },
    "The Secure Enclave did not sign the request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Secure Enclave hat die Anfrage nicht signiert."
          }
        }
      }
    },
    "The Secure Enclave key no longer exists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Secure-Enclave-Schlüssel existiert nicht mehr."
          }
        }
      }
    },
    "The Secure Enclave key reference is missing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verweis auf den Secure-Enclave-Schlüssel fehlt."
          }
        }
      }
    },
    "The app lock needs a login password on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Sperre benötigt auf diesem Mac ein Anmeldepasswort."
          }
        }
      }
    },
    "The archive could not be verified. Your key was not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Archiv konnte nicht überprüft werden. Dein Schlüssel wurde nicht geändert."
          }
        }
      }
    },
    "The archive key in your Keychain may have been removed or the archive was damaged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Archivschlüssel in deinem Schlüsselbund wurde möglicherweise entfernt oder das Archiv ist beschädigt."
          }
        }
      }
    },
    "The backup could not be opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung konnte nicht geöffnet werden."
          }
        }
      }
    },
    "The backup is damaged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung ist beschädigt."
          }
        }
      }
    },
    "The backup is encrypted with AES-256-GCM. Without this passphrase nobody can open it, including you: SMP does not store it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung wird mit AES-256-GCM verschlüsselt. Ohne diese Passphrase kann niemand sie öffnen – auch du nicht: SMP speichert sie nicht."
          }
        }
      }
    },
    "The comment must be a single line of at most 1024 characters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kommentar muss eine einzelne Zeile mit höchstens 1024 Zeichen sein."
          }
        }
      }
    },
    "The connection failed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung ist fehlgeschlagen."
          }
        }
      }
    },
    "The connection timed out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung bei der Verbindung."
          }
        }
      }
    },
    "The files are overwritten and deleted. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien werden überschrieben und gelöscht. Das kann nicht widerrufen werden."
          }
        }
      }
    },
    "The files move into SMP's encrypted archive and can be restored at any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien kommen in das verschlüsselte Archiv von SMP und können jederzeit wiederhergestellt werden."
          }
        }
      }
    },
    "The host key changed… Verify and replace": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Host-Schlüssel hat sich geändert … Prüfen und ersetzen"
          }
        }
      }
    },
    "The host name could not be found.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hostname wurde nicht gefunden."
          }
        }
      }
    },
    "The key file belongs to another user.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlüsseldatei gehört einem anderen Benutzer."
          }
        }
      }
    },
    "The key file is inconsistent: its public and private parts don't match.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlüsseldatei ist inkonsistent: Öffentlicher und privater Teil passen nicht zusammen."
          }
        }
      }
    },
    "The key needs a name of at most 200 characters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel braucht einen Namen mit höchstens 200 Zeichen."
          }
        }
      }
    },
    "The key was not converted to the OpenSSH format.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel wurde nicht ins OpenSSH-Format umgewandelt."
          }
        }
      }
    },
    "The key will be converted to the OpenSSH format.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel wird ins OpenSSH-Format umgewandelt."
          }
        }
      }
    },
    "The key's folder is accessible by other users (%@). Use 700.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner des Schlüssels ist für andere Benutzer zugänglich (%@). Verwende 700."
          }
        }
      }
    },
    "The network or host is unreachable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Netzwerk oder der Host ist nicht erreichbar."
          }
        }
      }
    },
    "The old key files are then moved to SMP's encrypted archive, where you can restore them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die alten Schlüsseldateien kommen dann in das verschlüsselte Archiv von SMP, aus dem du sie wiederherstellen kannst."
          }
        }
      }
    },
    "The passphrase for “%@” is missing or incorrect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Passphrase für „%@“ fehlt oder ist falsch."
          }
        }
      }
    },
    "The passphrases don't match.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Passphrasen stimmen nicht überein."
          }
        }
      }
    },
    "The previous “%@” was moved to the archive.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der bisherige „%@“ wurde ins Archiv verschoben."
          }
        }
      }
    },
    "The private key can never leave this Mac: it is not part of backups or archives, and it is gone if this Mac is erased. Keep a second way into your servers. SMP Agent keeps the key and signs with it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der private Schlüssel kann diesen Mac nie verlassen: Er ist nicht Teil von Sicherungen oder Archiven und geht verloren, wenn dieser Mac gelöscht wird. Halte dir einen zweiten Zugang zu deinen Servern offen. SMP Agent verwahrt den Schlüssel und signiert mit ihm."
          }
        }
      }
    },
    "The private key has no passphrase.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der private Schlüssel hat keine Passphrase."
          }
        }
      }
    },
    "The private key is saved with permissions 600 and never leaves your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der private Schlüssel wird mit den Rechten 600 gespeichert und verlässt deinen Mac nie."
          }
        }
      }
    },
    "The private key lives in this Mac's Secure Enclave and can never be copied or exported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der private Schlüssel liegt in der Secure Enclave dieses Macs und kann nie kopiert oder exportiert werden."
          }
        }
      }
    },
    "The private key uses the legacy %@ format.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der private Schlüssel verwendet das alte %@-Format."
          }
        }
      }
    },
    "The private key, public key and certificate are renamed together.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Privater Schlüssel, öffentlicher Schlüssel und Zertifikat werden gemeinsam umbenannt."
          }
        }
      }
    },
    "The provider account was removed from SMP.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter-Account wurde aus SMP entfernt."
          }
        }
      }
    },
    "The provider pointed SMP to a different server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat SMP an einen anderen Server verwiesen."
          }
        }
      }
    },
    "The provider sent an unexpectedly large response.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat eine unerwartet große Antwort gesendet."
          }
        }
      }
    },
    "The public key is not available for this file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Datei ist kein öffentlicher Schlüssel verfügbar."
          }
        }
      }
    },
    "The public key is not available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der öffentliche Schlüssel ist nicht verfügbar."
          }
        }
      }
    },
    "The public key of “%@” is not available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der öffentliche Schlüssel von „%@“ ist nicht verfügbar."
          }
        }
      }
    },
    "The security key application must start with “ssh:”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anwendung des Sicherheitsschlüssels muss mit „ssh:“ beginnen."
          }
