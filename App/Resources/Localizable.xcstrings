    "Secure Enclave": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave"
          }
        }
      }
    },
    "Secure Enclave key “%@” created. It can only be used through SMP's agent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure-Enclave-Schlüssel „%@“ erstellt. Er kann nur über den Agent von SMP verwendet werden."
          }
        }
      }
    },
    "Secure Enclave keys are kept by SMP Agent. Start it to see and manage them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure-Enclave-Schlüssel werden von SMP Agent verwahrt. Starte ihn, um sie zu sehen und zu verwalten."
          }
        }
      }
    },
    "Secure Enclave keys cannot be archived: they can never leave this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure-Enclave-Schlüssel können nicht archiviert werden: Sie können diesen Mac nie verlassen."
          }
        }
      }
    },
    "Secure Enclave keys follow their own Touch ID setting (see the key's details). Approvals end when the screen locks or the Mac sleeps. Requests to add keys or lock the agent are refused; add file keys with ssh-add as usual.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure-Enclave-Schlüssel folgen ihrer eigenen Touch-ID-Einstellung (siehe Details des Schlüssels). Freigaben enden, wenn der Bildschirm gesperrt wird oder der Mac schläft. Anfragen, Schlüssel hinzuzufügen oder den Agent zu sperren, werden abgelehnt; füge Dateischlüssel wie gewohnt mit ssh-add hinzu."
          }
        }
      }
    },
    "Secure Enclave keys need a Mac with Apple silicon or a T2 chip.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure-Enclave-Schlüssel brauchen einen Mac mit Apple Chip oder T2-Chip."
          }
        }
      }
    },
    "Secure Enclave keys sign through SMP Agent, not in the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure-Enclave-Schlüssel signieren über SMP Agent, nicht in der App."
          }
        }
      }
    },
