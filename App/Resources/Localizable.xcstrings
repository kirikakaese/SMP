          "stringUnit": {
            "state": "translated",
            "value": "optionaler Pfad"
          }
        }
      }
    },
    "other keys come from the system ssh-agent": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "weitere Schlüssel kommen vom ssh-agent des Systems"
          }
