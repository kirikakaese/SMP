    "Signatures happen without a prompt while your Mac is unlocked. This cannot be changed later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaturen erfolgen ohne Rückfrage, solange dein Mac entsperrt ist. Das kann später nicht geändert werden."
          }
        }
      }
    },
    "Signatures need Touch ID or your login password. This requirement cannot be removed later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaturen brauchen Touch ID oder dein Anmeldepasswort. Diese Anforderung kann später nicht entfernt werden."
