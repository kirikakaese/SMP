{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    "%@": {
      "shouldTranslate": false
    },
    "%@ %@ ago": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vor %1$@ %2$@"
          }
        }
      }
    },
    "%@ answered with HTTP %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat mit HTTP %2$lld geantwortet."
          }
        }
      }
    },
    "%@ did not finish within %lld seconds and was stopped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wurde nicht innerhalb von %2$lld Sekunden fertig und wurde gestoppt."
          }
        }
      }
    },
    "%@ did not return any host keys.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat keine Host-Schlüssel zurückgegeben."
          }
        }
      }
    },
    "%@ does not store SSH signing keys.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ speichert keine SSH-Signaturschlüssel."
          }
        }
      }
    },
    "%@ is a symbolic link; fix its target instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein symbolischer Link; korrigiere stattdessen sein Ziel."
          }
        }
      }
    },
    "%@ is limiting requests right now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ begrenzt gerade die Anfragen."
          }
        }
      }
    },
    "%@ is missing or too large to be an SMP backup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fehlt oder ist zu groß für eine SMP-Sicherung."
          }
        }
      }
    },
    "%@ is not a readable SSH config file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist keine lesbare SSH-Konfigurationsdatei."
          }
        }
      }
    },
    "%@ is not a regular file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist keine normale Datei."
          }
        }
      }
    },
    "%@ is not installed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht installiert."
          }
        }
      }
    },
    "%@ rejected the token.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat das Token abgelehnt."
          }
        }
      }
    },
    "%@ reported an error (exit code %d).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat einen Fehler gemeldet (Exit-Code %2$d)."
          }
        }
      }
    },
    "%@ was cancelled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde abgebrochen."
          }
        }
      }
    },
    "%@ was changed by another program after SMP read it. Nothing was saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde von einem anderen Programm geändert, nachdem SMP die Datei gelesen hat. Es wurde nichts gesichert."
          }
        }
      }
    },
