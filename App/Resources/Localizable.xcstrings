          }
        }
      }
    },
    "Runs SMP's security audit on your keys and ~/.ssh/config and returns the score (0–100).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt die Sicherheitsprüfung von SMP für deine Schlüssel und ~/.ssh/config aus und gibt die Punktzahl (0–100) zurück."
