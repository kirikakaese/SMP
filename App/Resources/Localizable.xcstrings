    "SMP data": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP-Daten"
          }
        }
      }
    },
    "SMP deletes the account's token from the Keychain. Keys on the provider stay as they are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP löscht das Token des Accounts aus dem Schlüsselbund. Schlüssel beim Anbieter bleiben unverändert."
          }
        }
      }
    },
    "SMP did not understand the response from %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP hat die Antwort von %@ nicht verstanden."
          }
        }
      }
    },
    "SMP doesn't recognize this option. Check for a typo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP kennt diese Option nicht. Prüfe sie auf Tippfehler."
          }
        }
      }
    },
    "SMP found %lld %@ in ~/.ssh.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP hat %1$lld %2$@ in ~/.ssh gefunden."
          }
        }
      }
    },
    "SMP found no keys in ~/.ssh yet. Create one with File → New Key (⌘N).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP hat noch keine Schlüssel in ~/.ssh gefunden. Erstelle einen mit Ablage → Neuer Schlüssel (⌘N)."
          }
        }
      }
    },
    "SMP found no provider account or ~/.ssh/config host that uses this key. Upload the new key manually where you used the old one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP hat keinen Anbieter-Account und keinen Host in ~/.ssh/config gefunden, der diesen Schlüssel verwendet. Lade den neuen Schlüssel dort manuell hoch, wo du den alten verwendet hast."
          }
        }
      }
    },
    "SMP imports OpenSSH, PEM, PKCS#8 and PuTTY private keys, and OpenSSH public keys.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP importiert private Schlüssel im OpenSSH-, PEM-, PKCS#8- und PuTTY-Format sowie öffentliche OpenSSH-Schlüssel."
          }
        }
      }
    },
    "SMP is locked": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP ist gesperrt"
          }
        }
      }
    },
    "SMP is still starting. Try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP startet noch. Versuche es erneut."
          }
        }
      }
    },
    "SMP keeps your SSH keys, hosts and agent in one place.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP vereint deine SSH-Schlüssel, Hosts und den Agent an einem Ort."
          }
        }
      }
    },
    "SMP only changes permissions inside your key folders.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP ändert Rechte nur innerhalb deiner Schlüsselordner."
          }
        }
      }
    },
    "SMP removes the old key from: %@. ": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP entfernt den alten Schlüssel von: %@. "
          }
        }
      }
    },
    "SMP replaces the old key everywhere it is used, then retires it. You can close this window at any time; the rotation continues where it stopped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP ersetzt den alten Schlüssel überall, wo er verwendet wird, und mustert ihn dann aus. Du kannst dieses Fenster jederzeit schließen; die Rotation geht dort weiter, wo sie aufgehört hat."
          }
        }
      }
    },
    "SMP shows this icon in the Dock while it's running. Finder and Launchpad keep the standard icon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP zeigt dieses Symbol im Dock, solange es läuft. Finder und Launchpad zeigen weiterhin das Standardsymbol."
          }
        }
      }
    },
    "SMP stays locked until you confirm with Touch ID or your password.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMP bleibt gesperrt, bis du mit Touch ID oder deinem Passwort bestätigst."
          }
        }
      }
    },
