          }
        }
      }
    },
    "This can mean the server was reinstalled, or that someone is intercepting the connection. Verify the new fingerprint with the server's admin before replacing the stored key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
