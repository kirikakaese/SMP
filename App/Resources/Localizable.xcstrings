    "An environment variable was malformed and was rejected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Umgebungsvariable war fehlerhaft und wurde abgelehnt."
          }
        }
      }
    },
    "Another SMP window is editing this file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes SMP-Fenster bearbeitet diese Datei."
          }
        }
      }
    },
    "Another copy of SMP's agent is already running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Kopie des SMP-Agents läuft bereits."
          }
        }
      }
    },
    "Anyone using this key loses access to %@. If it is the key you are logged in with, make sure you have another way in. A backup is kept on the server as authorized_keys.smp-backup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer diesen Schlüssel verwendet, verliert den Zugang zu %@. Wenn du dich mit diesem Schlüssel anmeldest, sorge für einen anderen Zugang. Auf dem Server bleibt eine Sicherung als authorized_keys.smp-backup."
          }
        }
      }
    },
    "Anyone who gets a copy of the file can use it immediately.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
