<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  SMP Agent (login-item helper). Hardened Runtime, not sandboxed (it must reach the system
  ssh-agent socket). Documented in docs/ENTITLEMENTS.md.
-->
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.kirikakaese.smp.shared</string>
	</array>
</dict>
</plist>
